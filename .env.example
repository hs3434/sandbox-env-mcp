# sandbox-mcp deployment overrides — copy to .env and customize per host.
# Everything here is optional; sensible defaults are baked into
# docker-compose.yml.

# Port the HTTP MCP server listens on, on BOTH host and container.
#SANDBOX_MCP_PORT=8010

# Path to the host's Docker daemon socket.  Varies for rootless setups
# (e.g. /run/user/1000/docker.sock).  System Docker usually lives at
# /var/run/docker.sock.
#DOCKER_SOCK_PATH=/var/run/docker.sock

# Host-side workspace root for docker_run bind mounts.  MUST match
# [storage] work_home in config.toml — sandbox-mcp's docker_build needs
# this path reachable inside the container as well.
#WORK_HOME=/var/lib/sandbox-mcp

# Directory containing the SSH private keys this sandbox-mcp instance
# is allowed to use (mounted read-only at
# /home/sandbox/.ssh_keys/ in the container).
#
# The default (your real ~/.ssh/) is convenient but exposes every key
# in that directory to the sandbox-mcp process.  If your ~/.ssh/
# contains high-value identities you don't want this container to
# touch, point this at a dedicated directory and symlink or copy
# just the keys sandbox-mcp needs:
#
#   mkdir -p ~/.sandbox-mcp-keys
#   chmod 700 ~/.sandbox-mcp-keys
#   ln -s ~/.ssh/windows_rsa ~/.sandbox-mcp-keys/windows_rsa
#   SSH_KEYS_DIR=$HOME/.sandbox-mcp-keys
#
# ssh.targets.*.key in config.toml references filenames that must
# exist inside this directory.
#SSH_KEYS_DIR=$HOME/.ssh